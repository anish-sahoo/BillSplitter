{
  "name": "bill-splitter",
  "compatibility_date": "2026-09-09",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from the static assets
    "run_worker_first": ["/api/*"],
  },
  // No id: wrangler creates the namespace on the first deploy
  "kv_namespaces": [{ "binding": "SHARES" }],
  // Keyed per IPv4 address or IPv6 /64. These are per Cloudflare location and
  // approximate, so they stop bursts and scripts, not a determined botnet.
  // namespace_id is any number unique among this account's rate limiters.
  "ratelimits": [
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
